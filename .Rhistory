#Start
library(Seurat)
library(ggplot2)
library(dplyr)
# 1.Load 10X Genomlics Matrix and Create Seurat Object 
adj.matrix = Read10X("/home/ibab/BDBP-307-Omics-Lab/Lab_11_single_cell/1_raw_data/Input")
srat = CreateSeuratObject(adj.matrix,project = "pbmc10k")
srat
srat
adj.matrix = NULL
str(srat)

meta = srat@meta.data
dim(meta)

summary(meta$nCount_RNA)
summary(meta$nFeature_RNA)
VlnPlot(srat, features = 
	c("nFeature_RNA","nCount_RNA","percent.mt","percent.rb"), 
	ncol = 4, pt.size = 0.1) 
	& theme(plot.title = element_text(size=10)
		)

doublets = read.table("/home/ibab/BDBP-307-Omics-Lab/Lab_11_single_cell/1_raw_data/Input/scrublet_calls.tsv",
	                       header = FALSE, row.names = 1, stringsAsFactors = FALSE)
colnames(doublets) = c("Doublet_score", "Is_doublets")
head(doublets)
srat = AddMetaData(srat,doublets)

FeatureScatter(srat, feature1 = "nCount_RNA", feature2 = "percent.mt")
FeatureScatter(srat, feature1 = "nCount_RNA", feature2 = "n_Feature_RNA")
FeatureScatter(srat, feature1 = "nCount_RNA", feature2 = "percent.rb")
FeatureScatter(srat, feature1 = "percent.rb", feature2 = "percent.mt")
FeatureScatter(srat, feature1 = "nCount_RNA", feature2 = "Doublet_score")

srat[['QC']] = ifelse(srat@meta.data$Is_doublet == 'True','Doublet','Pass')

srat = NormalizeData(srat)

srat = FindVariableFeatures(srat, selection.method = "vst", nfeatures = 2000)

top10 = head(VariableFeatures(srat), 10)
top10
#Start day 2 
library(Seurat)
library(ggplot2)
library(dplyr)
library(RColorBrewer)

all.genes = rownames(srat)
srat = ScaleData(srat, feature = all.genes)
[200~srat = ScaleData(srat, feature = all.genes)~
srat = ScaleData(srat, feature = all.genes)
# 1. Mitochondrial percentage (human genes start with "MT-")
srat[["percent.mt"]] <- PercentageFeatureSet(srat, pattern = "^MT-")
summary(srat$percent.mt)                      # should not be all zeros

# 2. QC plots (these are the lines that failed)
VlnPlot(srat, features = c("nFeature_RNA", "nCount_RNA", "percent.mt"), ncol = 3)
FeatureScatter(srat, feature1 = "nCount_RNA", feature2 = "percent.mt")

# 3. Filter cells: use the thresholds from your lab handout; the values below are only an example
srat <- subset(srat, subset = nFeature_RNA > 200 & nFeature_RNA < 6000 & percent.mt < 10)

# 4. Normalize, find variable genes, scale, PCA
srat <- NormalizeData(srat)
srat <- FindVariableFeatures(srat, nfeatures = 2000)
all.genes <- rownames(srat)
srat <- ScaleData(srat, features = all.genes)
srat <- RunPCA(srat)
srat = RunPCA(srat, features = VariableFeatures(object = srat))
VizDimLoadings(srat, dim = 1:9, reduction = "pca") & 
theme(axis.text=element_text(size=5),axis.title=element_text(size=8,face="bold"))
DimHeatmap(srat, dims = 1:6, nfeatures = 20, cells = 500, balanced = T)
DimHeatmap(srat, dims = 1:6, nfeatures = 20, cells = 500, balanced = T, fast = FALSE)
DimPlot(srat, reduction = "pca")
ElbowPlot(srat)
DimPlot(srat, reduction = "pca", dim = c(1,2))
DimPlot(srat, reduction = "pca", dim = c(1,3))
DimPlot(srat, reduction = "pca", dim = c(1,4))
srat = FindNeighbors(srat,dims = 1:10)
srat = FindClusters(srat, resolution = 0.5)
srat = RunUMAP(srat, dims = 1:10, verbose = F)
DimPlot(srat,label.size = 4, repel = T, label = T)
ElbowPlot(srat)
FeaturePlot(srat, features = "nFeature_RNA") & theme(plot.title = element_text(size = 10))
DimPlot(srat, reduction = "pca", dim = c(1,2))
DimPlot(srat, reduction = "pca", dim = c(1,3))
DimPlot(srat, reduction = "pca", dim = c(1,4))
srat = FindNeighbors(srat,dims = 1:10)
srat = FindClusters(srat, resolution = 0.5)
srat = RunUMAP(srat, dims = 1:10, verbose = F)
DimPlot(srat,label.size = 4, repel = T, label = T)
srat = FindNeighbors(srat,dims = 1:10)
srat = FindClusters(srat, resolution = 0.2)
srat = RunUMAP(srat, dims = 1:10, verbose = F)
DimPlot(srat,label.size = 4, repel = T, label = T)
ggsave("umap_clusters_resolution_0.2.png", plot = P, width = 7, height = 6, dpi = 300)
FeaturePlot(srat, features = "nFeature_RNA") & theme(plot.title = element_text(size = 10))
FeaturePlot(srat, features = "Doublet_score") & theme(plot.title = element_text(size = 10))
p=FeaturePlot(srat, features = “Doublet_score”) & theme(plot.title = element_text(size = 10))
ggsave("umap_Doublet_score_RNA.png", plot = p, width = 7, height = 6, dpi = 300)
FeaturePlot(srat, features = "percent.mt") & theme(plot.title = element_text(size = 10))
p=FeaturePlot(srat, features = "percent.mt") & theme(plot.title = element_text(size = 10))
ggsave("umap_percent.mt_RNA.png", plot = p, width = 7, height = 6, dpi = 300)
FeaturePlot(srat, features = c("MS4A1", "LYZ", "NKG7", "CD8D", "IL7R", "CD14"))
a=FeaturePlot(srat, features = c("MS4A1", "LYZ", "NKG7", "CD8D", "IL7R", "CD14"))
ggsave("umap_featureplot_markers.png", plot = a, width = 7, height = 6, dpi = 300)
VlnPlot(srat, features = c("MS4A1", "LYZ", "NKG7", "CD8B"), ncol = 2, pt.size = 0.1 ) & theme(plot.title = element_text(size=10))

canonical_markers = c("MS4A1", "LYZ", "NKG7", "CD8B")
DotPlot(srat, features = canonical_markers) + RotatedAxis()

 FeaturePlot(srat, "LYZ", pt.size= 0.3) + scale_colour_gradientn(colours = rev(brewer.pal(n=11,name="Spectral"))) + ggtitle("LYZ: Monocytes")

 FeaturePlot(srat, "NKG7", pt.size= 0.3) + scale_colour_gradientn(colours = rev(brewer.pal(n=11,name="Spectral"))) + ggtitle("NKG7: Natural Killer")

 FeaturePlot(srat, "CD8B", pt.size= 0.3) + scale_col
